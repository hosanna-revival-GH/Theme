{% doc %}
  @prompt
    a promotional grid that is four across on desktop, and stacks two by two on mobile
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-promo-grid-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
  }
  .ai-promo-grid-{{ ai_gen_id }}__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: {{ block.settings.gap }}px;
  }
  .ai-promo-grid-{{ ai_gen_id }}__item {
    position: relative;
    display: flex;
    min-width: 0;
    aspect-ratio: 1 / 1;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: {{ block.settings.tile_background }};
    color: {{ block.settings.text_color }};
    text-align: center;
    text-decoration: none;
  }
  .ai-promo-grid-{{ ai_gen_id }}__image,
  .ai-promo-grid-{{ ai_gen_id }}__placeholder {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .ai-promo-grid-{{ ai_gen_id }}__image { object-fit: cover; }
  .ai-promo-grid-{{ ai_gen_id }}__placeholder { display: flex; align-items: center; justify-content: center; }
  .ai-promo-grid-{{ ai_gen_id }}__placeholder svg { width: 100%; height: 100%; object-fit: cover; }
  .ai-promo-grid-{{ ai_gen_id }}__shade {
    position: absolute;
    inset: 0;
    background: {{ block.settings.overlay_color }};
    opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
  }
  .ai-promo-grid-{{ ai_gen_id }}__copy {
    position: relative;
    z-index: 1;
    width: 100%;
    padding: 12px;
    text-shadow: 0 1px 4px rgba(0,0,0,.45);
  }
  .ai-promo-grid-{{ ai_gen_id }}__title {
    margin: 0;
    font-family: {{ settings.type_header_font_family.family }}, {{ settings.type_header_font_family.fallback_families }};
    font-size: clamp(15px, 2vw, {{ block.settings.title_size }}px);
    line-height: 1.25;
  }
  .ai-promo-grid-{{ ai_gen_id }}__link-label {
    display: inline-block;
    margin-top: 8px;
    color: inherit;
    font-size: 13px;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .ai-promo-grid-{{ ai_gen_id }}__item:focus-visible { outline: 3px solid #990038; outline-offset: 3px; z-index: 2; }
  @media screen and (max-width: 749px) {
    .ai-promo-grid-{{ ai_gen_id }}__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
{% endstyle %}

<div class="ai-promo-grid-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-promo-grid-{{ ai_gen_id }}__grid">
    {% for i in (1..4) %}
      {% liquid
        assign image_key = 'image_' | append: i
        assign title_key = 'title_' | append: i
        assign link_key = 'link_' | append: i
        assign image = block.settings[image_key]
        assign title = block.settings[title_key]
        assign link = block.settings[link_key]
      %}
      {% if link != blank %}<a class="ai-promo-grid-{{ ai_gen_id }}__item" href="{{ link }}" aria-label="{{ title | escape }}">{% else %}<div class="ai-promo-grid-{{ ai_gen_id }}__item">{% endif %}
        {% if image != blank %}
          <img class="ai-promo-grid-{{ ai_gen_id }}__image" src="{{ image | image_url: width: 900 }}" alt="{{ image.alt | escape }}" loading="lazy" width="{{ image.width }}" height="{{ image.height }}">
        {% else %}
          <div class="ai-promo-grid-{{ ai_gen_id }}__placeholder">{{ 'image' | placeholder_svg_tag }}</div>
        {% endif %}
        <span class="ai-promo-grid-{{ ai_gen_id }}__shade" aria-hidden="true"></span>
        <span class="ai-promo-grid-{{ ai_gen_id }}__copy">
          {% if title != blank %}<span class="ai-promo-grid-{{ ai_gen_id }}__title">{{ title | escape }}</span>{% endif %}
          {% if link != blank and block.settings.link_label != blank %}<span class="ai-promo-grid-{{ ai_gen_id }}__link-label">{{ block.settings.link_label | escape }}</span>{% endif %}
          {% if image == blank %}<span class="ai-promo-grid-{{ ai_gen_id }}__link-label">Add an image{% if title == blank %} and title{% endif %}</span>{% endif %}
        </span>
      {% if link != blank %}</a>{% else %}</div>{% endif %}
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Promotional grid",
  "settings": [
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "header", "content": "Tile content" },
    { "type": "image_picker", "id": "image_1", "label": "Image 1" },
    { "type": "text", "id": "title_1", "label": "Title 1", "default": "Shop the collection" },
    { "type": "url", "id": "link_1", "label": "Link 1" },
    { "type": "image_picker", "id": "image_2", "label": "Image 2" },
    { "type": "text", "id": "title_2", "label": "Title 2", "default": "New arrivals" },
    { "type": "url", "id": "link_2", "label": "Link 2" },
    { "type": "image_picker", "id": "image_3", "label": "Image 3" },
    { "type": "text", "id": "title_3", "label": "Title 3", "default": "Best sellers" },
    { "type": "url", "id": "link_3", "label": "Link 3" },
    { "type": "image_picker", "id": "image_4", "label": "Image 4" },
    { "type": "text", "id": "title_4", "label": "Title 4", "default": "Shop all" },
    { "type": "url", "id": "link_4", "label": "Link 4" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Explore" },
    { "type": "header", "content": "Style" },
    { "type": "range", "id": "gap", "label": "Tile spacing", "min": 0, "max": 30, "step": 2, "unit": "px", "default": 12 },
    { "type": "range", "id": "title_size", "label": "Title size", "min": 16, "max": 40, "step": 2, "unit": "px", "default": 24 },
    { "type": "color", "id": "tile_background", "label": "Tile background", "default": "#2D4834" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#FFFFFF" },
    { "type": "color", "id": "overlay_color", "label": "Overlay", "default": "#000000" },
    { "type": "range", "id": "overlay_opacity", "label": "Overlay opacity", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 30 }
  ],
  "presets": [{ "name": "Promotional grid" }],
  "tag": null,
  "class": "promotional-grid-block"
}
{% endschema %}